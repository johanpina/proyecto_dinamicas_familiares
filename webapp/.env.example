# Copie este archivo como .env y cambie los valores antes de desplegar.

# Llave para firmar las sesiones. Genérela con:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cuenta de coordinación que se crea la primera vez que arranca el servidor
USUARIO_INICIAL=coordinacion
CLAVE_INICIAL=

# Código que debe traer el enlace del formulario (…/?c=elcodigo).
# Si se deja vacío, el formulario queda abierto para cualquiera.
CODIGO_ACCESO=

# Tope de envíos por hora y por IP en las rutas abiertas (por defecto 120)
# LIMITE_POR_IP=120

# Contraseña de PostgreSQL (solo si usa docker-compose)
CLAVE_DB=

# Opcional: si no se define, la aplicación usa SQLite en datos/entrevistas.db
# DATABASE_URL=postgresql+psycopg://familias:clave@localhost:5432/familias
