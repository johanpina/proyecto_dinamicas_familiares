{
  "version": 2,
  "builds": [
    {
      "src": "agente/api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "agente/api/index.py"
    }
  ],
  "functions": {
    "agente/api/index.py": {
      "maxDuration": 60
    }
  }
}
